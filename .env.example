# DubaiEstate AI 360 - Root Environment Template
# ==============================================================================
# IMPORTANT:
# 1. This file contains ONLY non-sensitive placeholder configurations.
# 2. DO NOT enter actual passwords, API keys, or production credentials here.
# 3. To configure your local environment, copy this file or the domain-specific
#    templates to local .env files (e.g. Full-Stack/backend/.env).
# 4. Local .env files are git-ignored and MUST NEVER be committed.
# ==============================================================================

# Backend Configuration (FastAPI)
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend Configuration (React + Vite)
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Shared Read-Only Dataset Directory (Relative to Full-Stack/backend)
DATASET_DIR=../../DataSets
