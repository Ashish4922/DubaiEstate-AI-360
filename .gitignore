# DubaiEstate AI 360 - Root .gitignore
# Protects all domains from committing sensitive secrets, dependencies, and temporary build files.

# Environment and Secrets (CRITICAL: Never commit real secrets or credentials)
.env
.env.*
!.env.example
*.env.local

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
.tox/

# Node & Frontend Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Frontend Build Outputs
Full-Stack/frontend/dist/
Full-Stack/frontend/dist-ssr/
*.local

# System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local Log Files
*.log
logs/
