# DubaiEstate AI 360 - Frontend Environment Configuration Template
# ==============================================================================
# Instructions:
# Copy this file to `Full-Stack/frontend/.env` for local frontend development.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# NEVER commit the actual `.env` file to Git.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Application Title
VITE_APP_TITLE=DubaiEstate AI 360
