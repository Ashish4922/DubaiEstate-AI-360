# DubaiEstate AI 360 - Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# Copy this file to `Full-Stack/backend/.env` for local backend development.
# NEVER commit the actual `.env` file to Git.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Server Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# API Versioning Prefix
API_V1_PREFIX=/api/v1

# Frontend Origin for CORS Middleware
FRONTEND_ORIGIN=http://localhost:5173

# Read-Only Datasets Directory (relative to Full-Stack/backend)
DATASET_DIR=../../DataSets
